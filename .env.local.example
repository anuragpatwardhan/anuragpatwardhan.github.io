# Optional: silent email delivery via Web3Forms.
# Without this, the contact form opens the visitor's email client (mailto) instead.
#
# To enable silent sending:
#   1. Go to https://web3forms.com
#   2. Enter patwardhan.an@northeastern.edu and submit
#   3. Web3Forms emails you an access key
#   4. Copy this file to .env.local and paste the key below
#
NEXT_PUBLIC_WEB3FORMS_KEY=YOUR_ACCESS_KEY_HERE
